# Full path to a Chrome or Chromium executable. Leave empty to use Puppeteer's bundled browser.
# Windows example: C:/Program Files/Google/Chrome/Application/chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# Set to false to skip the browser challenge and save only Axios's raw response.
METEO_USE_PUPPETEER=true

# Optional directory for HTML and JSON traces when the observation table is missing.
# Defaults to .debug/meteociel in the project root.
METEO_TRACE_DIR=

# Minimum console log level: debug, info, warn, or error.
# Use warn for normal runs, info/debug when investigating the scraper.
LOG_LEVEL=warn
